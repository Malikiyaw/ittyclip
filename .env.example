# ittyclip AI engine (NVIDIA NIM). Copy to .env.local and fill in.
# NEVER commit .env.local — it is gitignored.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for highlight analysis (primary), and automatic failover model.
# Both must be models available on https://integrate.api.nvidia.com
AI_PRIMARY_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
AI_FAST_MODEL=openai/gpt-oss-120b

# Optional tuning
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=3500
